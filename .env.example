# Copy this file's values into Vercel Project Settings -> Environment Variables.
# Nothing in this file is read automatically in production; Vercel injects
# whatever you set in the dashboard into process.env for the /api functions.

# --- Supabase (Settings -> API in your Supabase project) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Service role key: SECRET. Only used server-side in /api functions, never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Hugging Face (huggingface.co/settings/tokens, free "Read" token) ---
HF_TOKEN=your-huggingface-token
# Optional override if you swap in a different hosted food classifier model.
HF_FOOD_MODEL_ID=prithivMLmods/Food-101-93M

# --- Resend (resend.com, free tier) ---
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=FitTrack <onboarding@resend.dev>
RECIPIENT_EMAIL=you@example.com

# --- Cron security ---
# Any random long string. Vercel automatically sends this as a Bearer token
# when it invokes your cron job, so /api/weekly-summary can verify the request
# is really from Vercel Cron and not a random visitor.
CRON_SECRET=generate-a-long-random-string

# --- Data retention ---
# How many days of food_logs to keep before the weekly job purges old rows.
FOOD_LOG_RETENTION_DAYS=90
